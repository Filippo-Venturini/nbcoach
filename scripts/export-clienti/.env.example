# Copia questo file come ".env" e compila i valori.
# NON committare il file .env: la secret key è segreta.

# URL del progetto Supabase
SUPABASE_URL=https://cbaaqlalswnfgtkkrpdj.supabase.co

# Secret key (nuovo sistema): Supabase Dashboard -> Project Settings -> API Keys
# -> crea/copia una "Secret key" (formato sb_secret_...). È SEGRETA.
SUPABASE_SECRET_KEY=sb_secret_incolla-qui

# (In alternativa, se usi ancora la vecchia chiave legacy, puoi mettere:
# SUPABASE_SERVICE_ROLE_KEY=eyJ... )

# Cartella dove salvare l'export. Lascia vuoto per creare "export/" accanto all'app.
# Su Windows usa il doppio backslash, es: C:\\Users\\NomeUtente\\Documents\\FitCoach-Backup
OUTPUT_DIR=
